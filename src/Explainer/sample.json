  "scenes": [
    {
      "segmentId": "s1",
      "kind": "process",
      "version": 1,
      "title": "Before anything runs",
      "items": [
        "Proposed command",
        "Assess the consequence",
        "Apply the permission rule"
      ],
      "text": "Your coding agent is about to run a command. How do you decide whether to let it?",
      "start": 0,
      "end": 5.352
    },
    {
      "segmentId": "s2",
      "kind": "comparison",
      "version": 1,
      "title": "Recognize a pattern or inspect its effect",
      "items": ["Known command patterns", "Consequences of this action"],
      "text": "A blocklist checks for commands you already marked as dangerous.",
      "start": 5.352,
      "end": 8.998
    },
    {
      "segmentId": "s3",
      "kind": "process",
      "version": 1,
      "title": "Ask two concrete questions",
      "items": ["What could change?", "How hard is it to undo?"],
      "text": "An intent check asks a different question: what could this action change, and how difficult would it be to undo?",
      "start": 8.998,
      "end": 16.254
    },
    {
      "segmentId": "s4",
      "kind": "branch",
      "version": 1,
      "title": "A force push can replace shared work",
      "items": ["Shared base", "Branch point", "Teammate work", "Current tip"],
      "text": "Take a force push. It can overwrite shared Git history. A small classifier can flag that consequence before execution.",
      "start": 16.254,
      "end": 25.6
    },
    {
      "segmentId": "s5",
      "kind": "process",
      "version": 1,
      "title": "The application makes the decision",
      "items": [
        "Receive the assessment",
        "Apply allow / block / ask rules",
        "Execute only with permission"
      ],
      "text": "Your application then applies the rule: allow, block, or ask you.",
      "start": 25.6,
      "end": 30.081
    },
    {
      "segmentId": "s6",
      "kind": "process",
      "version": 1,
      "title": "Keep more than one safeguard",
      "items": [
        "The model can misjudge",
        "Restrict available permissions",
        "Ask before consequential actions"
      ],
      "text": "The classifier can be wrong. Keep permission limits and human approval around consequential actions.",
      "start": 30.081,
      "end": 36.931
    },
    {
      "segmentId": "s7",
      "kind": "comparison",
      "version": 1,
      "title": "Judgment informs. Rules control.",
      "items": ["MODEL: assess risk", "CODE: enforce permissions"],
      "text": "Use the model to assess risk. Keep the rules in code.",
      "start": 36.931,
      "end": 40.124063
    }
