# YouTube / inbox
AUDIOGRAM_YOUTUBE_PLAYLIST=Audiogram Inbox
AUDIOGRAM_VIDEO_ID=
# Optional override; storage paths must be absolute.
# AUDIOGRAM_DB_PATH=/absolute/path/to/audiograms.sqlite
AUDIOGRAM_PROJECT_ROOT=.
AUDIOGRAM_GOOGLE_CLIENT_PATH=./.credentials/google-oauth-client.json
AUDIOGRAM_GOOGLE_TOKEN_PATH=./.credentials/google-oauth-token.json

# Selector configuration
# youtube-heatmap | transcript-llm
AUDIOGRAM_CLIP_SELECTOR=transcript-llm
AUDIOGRAM_LLM_PROVIDER=chatgpt-oauth
AUDIOGRAM_TRANSCRIPT_CLIP_COUNT=3
AUDIOGRAM_PACKAGE_VERSION=transcript-llm-v1
AUDIOGRAM_MAX_CLIPS=1
AUDIOGRAM_MINIMUM_CLIP_SEPARATION_SECONDS=20

# Use only when AUDIOGRAM_LLM_PROVIDER=openai-api.
OPENAI_API_KEY=

# ChatGPT OAuth uses the external Application Support path by default.
# For a custom location, set AUDIOGRAM_CHATGPT_AUTH_PATH to an absolute path
# outside this repository. Do not commit the credential file.

# Jev is enabled in this example. Replace the endpoint and supply your key.
TYPESAFE_JEV_ENDPOINT=https://your-typesafe-endpoint.example/v1/judge
TYPESAFE_JEV_API_KEY=

# Optional publishing server
PORT=8787
# Optional SQLite override. PUBLISHING_DB is a legacy alias; if both are set,
# they must resolve to the same absolute path.
# INSTAGRAM_PUBLISHING_DB_PATH=/absolute/path/to/instagram-publishing.sqlite
# PUBLISHING_DB=/absolute/path/to/instagram-publishing.sqlite

# Optional storage overrides. By default, the data root is
# <home>/Library/Application Support/Audiogram Inbox, the artifact root is the
# data root, and the publishing DB is <data root>/instagram-publishing.sqlite.
# Use persistent absolute paths on a server.
# AUDIOGRAM_DATA_ROOT=/absolute/path/to/audiograms
# AUDIOGRAM_ARTIFACT_ROOT=/absolute/path/to/artifacts

# Native Instagram worker (Facebook Login); never commit real credentials.
# Pass this env file explicitly to Node; worker requires item and live flags.
INSTAGRAM_PAGE_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_PAGE_ID=
INSTAGRAM_GRAPH_VERSION=v26.0

# Dedicated sample preview server. The root must be absolute and outside Git checkouts.
# Default root: <AUDIOGRAM_DATA_ROOT>/template-samples
# AUDIOGRAM_SAMPLE_ROOT=/absolute/path/to/template-samples
AUDIOGRAM_SAMPLE_PORT=8790

# Optional signed job notifications. Keep disabled until the operator configures
# a persistent, private 32-byte base64 protection key outside tracked files.
AUDIOGRAM_MCP_EVENTS_ENABLED=0
# Private tunnel only; shared mode requires an authenticated principal resolver.
# AUDIOGRAM_MCP_EVENTS_MODE=private-tunnel
# AUDIOGRAM_EVENT_SECRET_KEY=<supplied securely at runtime; never commit>
# AUDIOGRAM_EVENT_KEY_VERSION=v1
